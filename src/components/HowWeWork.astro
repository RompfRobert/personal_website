---
const steps = [
  {
    number: '01',
    title: 'Discovery Call (30 min)',
    description:
      'We discuss your infrastructure, current pain points, and what you need. No commitment required.',
  },
  {
    number: '02',
    title: 'Proposal',
    description:
      'You receive a clear scope of work, timeline, rate, and deliverables within 48 hours.',
  },
  {
    number: '03',
    title: 'Contract and Start',
    description:
      'B2B contract via my Slovak LLC. Work begins within agreed timeline. Daily async updates.',
  },
  {
    number: '04',
    title: 'Delivery and Handover',
    description:
      "All infrastructure is documented. Terraform is modular. Your team can own it after I'm done.",
  },
];
---

<section class="border-t border-[#1f1f1f] py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="mb-16">
      <p class="section-label">Process</p>
      <h2 class="section-heading">How Engagements Work</h2>
    </div>

    <!-- Desktop: horizontal timeline -->
    <div class="relative hidden grid-cols-4 gap-0 md:grid">
      <!-- Connector line -->
      <div
        class="absolute left-[12.5%] right-[12.5%] top-5 h-px bg-gradient-to-r from-transparent via-[#1f1f1f] to-transparent"
      >
      </div>

      {
        steps.map((step) => (
          <div class="flex flex-col items-center px-4 text-center">
            <div class="relative z-10 mb-5 flex h-10 w-10 items-center justify-center rounded-full border-2 border-accent bg-[#111]">
              <span class="font-mono text-xs font-bold text-accent">{step.number}</span>
            </div>
            <h3 class="mb-2 font-display text-sm font-semibold text-[#f0f0f0]">{step.title}</h3>
            <p class="text-xs leading-relaxed text-muted">{step.description}</p>
          </div>
        ))
      }
    </div>

    <!-- Mobile: vertical timeline -->
    <div class="flex flex-col gap-0 md:hidden">
      {
        steps.map((step, i) => (
          <div class="flex gap-5">
            <div class="flex flex-col items-center">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full border-2 border-accent bg-[#111]">
                <span class="font-mono text-xs font-bold text-accent">{step.number}</span>
              </div>
              {i < steps.length - 1 && <div class="my-2 w-px flex-1 bg-[#1f1f1f]" />}
            </div>
            <div class="pb-8 pt-1.5">
              <h3 class="mb-1.5 font-display text-base font-semibold text-[#f0f0f0]">
                {step.title}
              </h3>
              <p class="text-sm leading-relaxed text-muted">{step.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
