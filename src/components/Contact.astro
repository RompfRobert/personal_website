---
import { FORMSPREE_ID, GITHUB, LINKEDIN } from '../data/site';

const formspreeUrl = `https://formspree.io/f/${FORMSPREE_ID}`;

const languages = [
  { name: 'English', level: 'Native' },
  { name: 'Hungarian', level: 'Native' },
  { name: 'Slovak', level: 'Fluent' },
  { name: 'Czech', level: 'Fluent' },
  { name: 'German', level: 'Learning' },
];
---

<section id="contact" class="border-t border-[#1f1f1f] py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="mb-16">
      <p class="section-label">Contact</p>
      <h2 class="section-heading">Let's Talk</h2>
      <p class="max-w-xl text-base text-muted">
        Describe your infrastructure challenge and I will get back to you within 24 hours.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-5 lg:gap-20">
      <!-- Form -->
      <div class="lg:col-span-3">
        <form action={formspreeUrl} method="POST" class="flex flex-col gap-5">
          <input type="hidden" name="_subject" value="New contract enquiry from rompf.dev" />
          <input type="text" name="_gotcha" class="hidden" />

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div class="flex flex-col gap-1.5">
              <label for="name" class="font-mono text-xs text-muted">Name *</label>
              <input
                id="name"
                type="text"
                name="name"
                required
                placeholder="Jane Smith"
                class="rounded-md border border-[#1f1f1f] bg-[#111] px-4 py-3 font-sans text-sm text-[#f0f0f0] transition-colors duration-200 placeholder:text-[#555] focus:border-accent focus:outline-none"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="company" class="font-mono text-xs text-muted">Company</label>
              <input
                id="company"
                type="text"
                name="company"
                placeholder="Acme Corp"
                class="rounded-md border border-[#1f1f1f] bg-[#111] px-4 py-3 font-sans text-sm text-[#f0f0f0] transition-colors duration-200 placeholder:text-[#555] focus:border-accent focus:outline-none"
              />
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="email" class="font-mono text-xs text-muted">Email *</label>
            <input
              id="email"
              type="email"
              name="email"
              required
              placeholder="jane@acme.com"
              class="rounded-md border border-[#1f1f1f] bg-[#111] px-4 py-3 font-sans text-sm text-[#f0f0f0] transition-colors duration-200 placeholder:text-[#555] focus:border-accent focus:outline-none"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="project-type" class="font-mono text-xs text-muted">Project Type</label>
            <select
              id="project-type"
              name="project_type"
              class="appearance-none rounded-md border border-[#1f1f1f] bg-[#111] px-4 py-3 font-sans text-sm text-[#f0f0f0] transition-colors duration-200 focus:border-accent focus:outline-none"
            >
              <option value="">Select a service...</option>
              <option value="AWS Infrastructure">AWS Infrastructure</option>
              <option value="Terraform / IaC">Terraform / IaC</option>
              <option value="CI/CD">CI/CD</option>
              <option value="Monitoring / Observability">Monitoring / Observability</option>
              <option value="Managed Ops Platform">Managed Ops Platform</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="message" class="font-mono text-xs text-muted">Message *</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Tell me about your infrastructure challenge..."
              class="resize-none rounded-md border border-[#1f1f1f] bg-[#111] px-4 py-3 font-sans text-sm text-[#f0f0f0] transition-colors duration-200 placeholder:text-[#555] focus:border-accent focus:outline-none"
            ></textarea>
          </div>

          <button type="submit" class="btn-primary w-fit">
            Send Message
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="22" y1="2" x2="11" y2="13"></line><polygon
                points="22 2 15 22 11 13 2 9 22 2"></polygon></svg
            >
          </button>
        </form>
      </div>

      <!-- Info panel -->
      <div class="flex flex-col gap-8 lg:col-span-2">
        <!-- Direct links -->
        <div>
          <h3 class="mb-4 font-mono text-xs uppercase tracking-widest text-accent">Direct Links</h3>
          <div class="flex flex-col gap-3">
            <a
              href={GITHUB}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-sm text-muted transition-colors duration-200 hover:text-[#f0f0f0]"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                ><path
                  d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                ></path></svg
              >
              github.com/RompfRobert
            </a>
            <a
              href={LINKEDIN}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-sm text-muted transition-colors duration-200 hover:text-[#f0f0f0]"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                ><path
                  d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                ></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"
                ></circle></svg
              >
              linkedin.com/in/robertrompf
            </a>
          </div>
        </div>

        <!-- Languages -->
        <div>
          <h3 class="mb-4 font-mono text-xs uppercase tracking-widest text-accent">Languages</h3>
          <div class="flex flex-col gap-2">
            {
              languages.map((lang) => (
                <div class="flex items-center justify-between">
                  <span class="text-sm text-[#f0f0f0]">{lang.name}</span>
                  <span class="font-mono text-xs text-muted">{lang.level}</span>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Response time -->
        <div class="rounded-lg border border-[#1f1f1f] bg-[#111] p-4">
          <div class="mb-2 flex items-center gap-2">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#94A3B8"
              stroke-width="2"
              ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
              ></polyline></svg
            >
            <span class="font-mono text-xs text-accent">Typical response time</span>
          </div>
          <p class="text-sm text-muted">
            Within 24 hours on business days. For urgent matters, mention it in your message.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
