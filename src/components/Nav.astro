---
import { AVAILABLE, CALENDLY } from '../data/site';
---

<header
  id="navbar"
  class="fixed left-0 right-0 top-0 z-50 border-b border-[#ffffff08] transition-all duration-300"
  style="background: rgba(5,5,5,0.85); backdrop-filter: blur(12px);"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 md:px-8">
    <!-- Logo -->
    <a
      href="/"
      class="font-mono text-sm font-semibold tracking-tight text-[#f0f0f0] transition-colors duration-200 hover:text-accent"
    >
      Robert Rompf
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-8 text-sm font-medium text-muted md:flex">
      <li>
        <a href="#services" class="transition-colors duration-200 hover:text-[#f0f0f0]">Services</a>
      </li>
      <li>
        <a href="#experience" class="transition-colors duration-200 hover:text-[#f0f0f0]"
          >Experience</a
        >
      </li>
      <li>
        <a href="#stack" class="transition-colors duration-200 hover:text-[#f0f0f0]">Stack</a>
      </li>
      <li>
        <a href="#certifications" class="transition-colors duration-200 hover:text-[#f0f0f0]"
          >Certifications</a
        >
      </li>
      <li>
        <a href="#contact" class="transition-colors duration-200 hover:text-[#f0f0f0]">Contact</a>
      </li>
    </ul>

    <!-- Right side -->
    <div class="hidden items-center gap-4 md:flex">
      <!-- Availability -->
      {
        AVAILABLE && (
          <div class="flex items-center gap-2 font-mono text-xs text-muted">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500" />
            </span>
            Available for contracts
          </div>
        )
      }
      {
        !AVAILABLE && (
          <div class="flex items-center gap-2 font-mono text-xs text-muted">
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[#888]" />
            Currently unavailable
          </div>
        )
      }
      <a href={CALENDLY} class="btn-primary px-4 py-2 text-xs"> Book a Call </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="nav-toggle"
      class="flex flex-col gap-1.5 rounded-md p-2 transition-colors duration-200 hover:bg-[#1f1f1f] md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span
        class="hamburger-bar block h-0.5 w-5 origin-center bg-[#f0f0f0] transition-all duration-300"
      ></span>
      <span class="hamburger-bar block h-0.5 w-5 bg-[#f0f0f0] transition-all duration-300"></span>
      <span
        class="hamburger-bar block h-0.5 w-5 origin-center bg-[#f0f0f0] transition-all duration-300"
      ></span>
    </button>
  </nav>

  <!-- Mobile drawer -->
  <div
    id="mobile-nav"
    class="hidden border-t border-[#1f1f1f] px-5 pb-6 pt-4 md:hidden"
    style="background: rgba(5,5,5,0.97);"
  >
    <ul class="mb-6 flex flex-col gap-4 text-sm font-medium text-[#f0f0f0]">
      <li>
        <a href="#services" class="block py-1 transition-colors duration-200 hover:text-accent"
          >Services</a
        >
      </li>
      <li>
        <a href="#experience" class="block py-1 transition-colors duration-200 hover:text-accent"
          >Experience</a
        >
      </li>
      <li>
        <a href="#stack" class="block py-1 transition-colors duration-200 hover:text-accent"
          >Stack</a
        >
      </li>
      <li>
        <a
          href="#certifications"
          class="block py-1 transition-colors duration-200 hover:text-accent">Certifications</a
        >
      </li>
      <li>
        <a href="#contact" class="block py-1 transition-colors duration-200 hover:text-accent"
          >Contact</a
        >
      </li>
    </ul>
    <div class="flex flex-col gap-3">
      {
        AVAILABLE && (
          <div class="flex items-center gap-2 font-mono text-xs text-muted">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500" />
            </span>
            Available for contracts
          </div>
        )
      }
      <a href={CALENDLY} class="btn-primary w-fit">Book a Call</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const bars = document.querySelectorAll('.hamburger-bar');

  let open = false;

  toggle?.addEventListener('click', () => {
    open = !open;
    toggle.setAttribute('aria-expanded', String(open));
    mobileNav?.classList.toggle('hidden', !open);

    if (open) {
      bars[0]?.classList.add('rotate-45', 'translate-y-2');
      bars[1]?.classList.add('opacity-0');
      bars[2]?.classList.add('-rotate-45', '-translate-y-2');
    } else {
      bars[0]?.classList.remove('rotate-45', 'translate-y-2');
      bars[1]?.classList.remove('opacity-0');
      bars[2]?.classList.remove('-rotate-45', '-translate-y-2');
    }
  });

  // Close mobile nav when a link is clicked
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      open = false;
      mobileNav.classList.add('hidden');
      bars[0]?.classList.remove('rotate-45', 'translate-y-2');
      bars[1]?.classList.remove('opacity-0');
      bars[2]?.classList.remove('-rotate-45', '-translate-y-2');
    });
  });
</script>
